{
  "name": "arpi-portfolio",
  "version": "0.1.0",
  "private": true,
  "description": "Public-facing portfolio website for Automotive Retail Performance Intelligence (ARPI).",
  "license": "MIT",
  "author": "Michael Palmer",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "manifest": "tsx scripts/generate-project-manifest.ts",
    "manifest:check": "tsx scripts/generate-project-manifest.ts --check",
    "inventory": "tsx scripts/generate-inventory-data.ts",
    "inventory:check": "tsx scripts/generate-inventory-data.ts --check",
    "dashboard": "tsx scripts/generate-dashboard-data.ts",
    "dashboard:check": "tsx scripts/generate-dashboard-data.ts --check",
    "prebuild": "npm run manifest:check && npm run inventory:check && npm run dashboard:check",
    "dev": "npm run manifest && npm run inventory && npm run dashboard && next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:a11y": "playwright test tests/e2e/accessibility.spec.ts",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run manifest:check && npm run inventory:check && npm run dashboard:check && npm run test && npm run build",
    "assets": "tsx scripts/render-raster-assets.ts",
    "media": "tsx scripts/capture-product-media.ts",
    "review:screenshots": "tsx scripts/capture-review-screenshots.ts",
    "bundle": "tsx scripts/report-bundle.ts",
    "density": "tsx scripts/report-console-density.ts"
  },
  "dependencies": {
    "lucide-react": "1.27.0",
    "motion": "12.43.0",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.62.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.20.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.12",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "30.0.1",
    "postcss": "8.5.25",
    "prettier": "3.9.6",
    "sharp": "0.35.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.3",
    "brace-expansion": "5.0.8",
    "minimatch": "10.2.6"
  }
}
