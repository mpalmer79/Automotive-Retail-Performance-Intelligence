/// Grain: one row per dealership per calendar month per lead source per campaign (nullable).
/// Governed SQL owner of KPI-MKT-001, KPI-MKT-002 and KPI-MKT-003. Month is the finest valid grain
/// and the guarantee is STRUCTURAL: the view joins to vw_calendar on the first day of the month, so
/// filtering to any other date returns nothing and a day-grain cost-per figure cannot be produced.
/// Spend and attributed outcomes are separate additive columns; the ratios are valid at this view's
/// grain only and should be recomputed with DIVIDE in DAX. Cost measures are NULL, never zero, for
/// organic and internal sources -- a walk-in has no cost per lead -- and those rows are published
/// rather than dropped so the organic tail stays visible. Zero denominators return NULL, never
/// infinity, and the three cases a ratio cannot express are surfaced as explicit flags. Attribution
/// is single-source and first-touch; sales and gross are attributed through the ORIGINATING LEAD'S
/// creation month, not the sale date, so cohort immaturity makes the current month always look
/// worst. Gross-based return is the primary return measure: revenue includes the cost of the
/// vehicle, so a revenue-based ROAS is inflated by roughly an order of magnitude;
/// attributed_revenue is exposed only for that comparison and is explicitly secondary. Even the
/// gross measure nets out no cost but the vehicle, so it is a contribution measure, not a profit
/// measure. ARPI publishes no target value.
table vw_marketing_performance
	lineageTag: a6bbd052-d3a6-5343-9849-e39259833500

	/// Store surrogate key. Relationship column into vw_dealership.
	column dealership_key
		dataType: int64
		isHidden
		sourceColumn: dealership_key
		summarizeBy: none
		lineageTag: 93aa7dfb-2820-5fb6-a7b8-a6bf070d89e3

		annotation SummarizationSetBy = User

	/// First day of the month, as a YYYYMMDD key. Relationship column into vw_calendar. Both spend and
	/// attributed outcomes are anchored here, which is what makes a day-grain cost figure impossible.
	column month_date_key
		dataType: int64
		isHidden
		sourceColumn: month_date_key
		summarizeBy: none
		lineageTag: 7b120c4e-c89f-5eaa-b252-b10ec3397550

		annotation SummarizationSetBy = User

	/// Lead source. Relationship column into vw_lead_source.
	column lead_source_key
		dataType: int64
		isHidden
		sourceColumn: lead_source_key
		summarizeBy: none
		lineageTag: 2da5716c-c94f-547b-9c6a-110a36396ab6

		annotation SummarizationSetBy = User

	/// Campaign, or NULL for source-level activity with no campaign. Relationship column into
	/// vw_marketing_campaign.
	column campaign_key
		dataType: int64
		isHidden
		sourceColumn: campaign_key
		summarizeBy: none
		lineageTag: 81e1d16b-0ae3-532c-8f91-de2464831e19

		annotation SummarizationSetBy = User

	/// Whether a cost figure is defined for this source at all. False for organic and internal sources,
	/// where every cost measure on the row is NULL by rule rather than by absence of data.
	column is_cost_attributable
		dataType: boolean
		sourceColumn: is_cost_attributable
		summarizeBy: none
		lineageTag: 8749d6bb-7672-5875-b6ce-c532598acb28

		annotation SummarizationSetBy = User

	/// KPI-MKT-001/002 numerator and the KPI-MKT-003 denominator. NULL -- not zero -- when the source-
	/// month carries no spend row at all, which is how an organic result is distinguished from a paid
	/// campaign that spent nothing.
	column spend_amount
		dataType: decimal
		sourceColumn: spend_amount
		summarizeBy: none
		lineageTag: 5e4b61a0-89e2-5ead-8dcc-36010af90485

		annotation SummarizationSetBy = User

	/// Vendor-reported impressions.
	column impressions
		dataType: int64
		sourceColumn: impressions
		summarizeBy: none
		lineageTag: 5bf182d5-ef25-52bd-bc73-a070cdee29c9

		annotation SummarizationSetBy = User

	/// Vendor-reported clicks.
	column clicks
		dataType: int64
		sourceColumn: clicks
		summarizeBy: none
		lineageTag: b4e315dc-2185-506b-9913-23bef9b4155a

		annotation SummarizationSetBy = User

	/// Leads as the VENDOR counts them. Deliberately differs from attributed_leads because vendors
	/// count differently and typically count duplicates. The gap is a finding to report, never a
	/// substitution to make.
	column vendor_reported_leads
		dataType: int64
		sourceColumn: vendor_reported_leads
		summarizeBy: none
		lineageTag: 8684a5aa-6664-5b83-99e9-6d2992f2f90b

		annotation SummarizationSetBy = User

	/// KPI-MKT-001 denominator: valid non-duplicate CRM leads created in the month and credited to this
	/// source and campaign.
	column attributed_leads
		dataType: int64
		sourceColumn: attributed_leads
		summarizeBy: none
		lineageTag: fcba3be2-0499-5cb3-8261-f49e485492cc

		annotation SummarizationSetBy = User

	/// Attributed leads that produced a finalized retail sale. The lead-side view of the same outcome
	/// attributed_retail_units measures on the sale side.
	column attributed_sold_leads
		dataType: int64
		sourceColumn: attributed_sold_leads
		summarizeBy: none
		lineageTag: 675be7d8-c645-5241-a155-4ee9c50474f7

		annotation SummarizationSetBy = User

	/// KPI-MKT-002 denominator: retail units delivered from the attributed leads, anchored to the
	/// LEAD'S creation month rather than the sale date.
	column attributed_retail_units
		dataType: int64
		sourceColumn: attributed_retail_units
		summarizeBy: none
		lineageTag: 57cdede7-347d-563a-8a7b-4388645697a1

		annotation SummarizationSetBy = User

	/// KPI-MKT-003 numerator: total retail gross from the attributed leads. The primary return
	/// numerator.
	column attributed_total_gross
		dataType: decimal
		sourceColumn: attributed_total_gross
		summarizeBy: none
		lineageTag: ff7f9109-1096-5c45-87b4-ee09c5dc41e6

		annotation SummarizationSetBy = User

	/// Front-end gross from the attributed leads, published so a channel can be read for vehicle profit
	/// separately from F&I.
	column attributed_front_end_gross
		dataType: decimal
		sourceColumn: attributed_front_end_gross
		summarizeBy: none
		lineageTag: fd39ff4b-d4c1-5f64-9adb-c71a928600db

		annotation SummarizationSetBy = User

	/// Retail selling price from the attributed leads. SECONDARY ONLY: revenue includes the cost of the
	/// vehicle, so a revenue-based return is inflated by roughly an order of magnitude and must never
	/// be presented as the primary profitability measure.
	column attributed_revenue
		dataType: double
		sourceColumn: attributed_revenue
		summarizeBy: none
		lineageTag: 4387ce80-164c-57de-b70a-4035d117c2d2

		annotation SummarizationSetBy = User

	/// KPI-MKT-001 at this view's grain. NULL for an organic or internal source, and NULL when spend
	/// produced zero leads -- report that case as spend with zero leads, not as an infinite cost. Says
	/// nothing about lead quality.
	column cost_per_lead
		dataType: decimal
		isHidden
		sourceColumn: cost_per_lead
		summarizeBy: none
		lineageTag: af48b923-4752-58d2-95cc-a80085e4d8d0

		annotation SummarizationSetBy = User

	/// KPI-MKT-002 at this view's grain. NULL for an organic or internal source, and NULL when spend
	/// produced zero attributed sales. Cohort immaturity is severe: the current month always looks
	/// worst and improves for weeks.
	column cost_per_sale
		dataType: decimal
		isHidden
		sourceColumn: cost_per_sale
		summarizeBy: none
		lineageTag: 37b0e24f-3d14-5b73-a964-e66f20970808

		annotation SummarizationSetBy = User

	/// KPI-MKT-003 at this view's grain, as a multiple to two decimals -- 1.0 means the channel
	/// returned exactly its cost in gross. NULL on zero spend, never infinity. A contribution measure,
	/// not a profit measure: no personnel, facility or floor-plan cost is netted out.
	column gross_return_on_ad_spend
		dataType: decimal
		isHidden
		sourceColumn: gross_return_on_ad_spend
		summarizeBy: none
		lineageTag: d9adee38-ecd2-5258-a588-78a4b6fcf6f2

		annotation SummarizationSetBy = User

	/// True where money was spent and no valid lead was attributed. The actionable statement a NULL
	/// cost_per_lead cannot make on its own.
	column spend_with_no_attributed_leads
		dataType: boolean
		sourceColumn: spend_with_no_attributed_leads
		summarizeBy: none
		lineageTag: c9a54cf3-89bb-52ba-beeb-38fbd6785290

		annotation SummarizationSetBy = User

	/// True where money was spent and no retail unit was attributed. Read with cohort maturity in mind
	/// before concluding anything.
	column spend_with_no_attributed_sales
		dataType: boolean
		sourceColumn: spend_with_no_attributed_sales
		summarizeBy: none
		lineageTag: 178c81b3-42f7-5ff7-9b9d-656e9a352aa3

		annotation SummarizationSetBy = User

	/// True where leads arrived with no spend row at all -- the organic and internal tail. Published so
	/// it is visible rather than silently absent.
	column leads_with_no_spend
		dataType: boolean
		sourceColumn: leads_with_no_spend
		summarizeBy: none
		lineageTag: c7149008-9120-5050-882b-c500ee8cbb9c

		annotation SummarizationSetBy = User

	partition vw_marketing_performance = m
		mode: import
		source =
				let
				    Source = PostgreSQL.Database(ArpiServer, ArpiDatabase),
				    Data = Source{[Schema = "reporting", Item = "vw_marketing_performance"]}[Data]
				in
				    Data

	annotation ARPI_SourceView = reporting.vw_marketing_performance

	annotation ARPI_Grain = One row per store x calendar month x lead source x campaign.

	annotation ARPI_TableRole = Analytical

	annotation PBI_ResultType = Table
