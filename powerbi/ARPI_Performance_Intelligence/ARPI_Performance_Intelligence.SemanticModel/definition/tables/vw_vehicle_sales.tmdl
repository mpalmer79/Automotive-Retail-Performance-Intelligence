/// Grain: one row per finalized vehicle transaction -- identical to warehouse.fact_vehicle_sale,
/// with no aggregation and no filtering. Fact table for the semantic model. Owns the row-level
/// inputs to KPI-SLS-001..003, KPI-GRS-001..006, KPI-INV-007, the KPI-INV-008 numerator, the KPI-
/// INV-009 denominator and the KPI-MKT-002/003 attributed measures. Retail-only numerators are
/// published as columns that are zero on excluded rows, so each measure is a plain additive SUM and
/// numerator and denominator cannot diverge. new_unit_count and used_unit_count split on the
/// VEHICLE condition, not on sale_type, because a lease is a retail sale type that sale_type alone
/// leaves outside both halves of the RECON-UNITS-001 identity; a certified pre-owned unit is a used
/// unit. No ratio is materialised: divide in DAX so the result recomputes at every level. Role-
/// playing dates sale_date_key and delivery_date_key both relate to vw_calendar -- one active, one
/// inactive -- never by duplicating the calendar. Surrogate keys should be hidden in the semantic
/// model.
table vw_vehicle_sales
	lineageTag: 93a77ac0-37b6-5bea-ae06-a7d2d4d6136c

	/// Warehouse surrogate key of the transaction. Relationship column for vw_leads and
	/// vw_appointments; hide in the semantic model.
	column sale_key
		dataType: int64
		isHidden
		sourceColumn: sale_key
		summarizeBy: none
		lineageTag: db45c414-e435-5e61-99a5-9e22f3527ead

		annotation SummarizationSetBy = User

	/// Stable business identifier of the transaction.
	column sale_code
		dataType: string
		sourceColumn: sale_code
		summarizeBy: none
		lineageTag: c92f13e8-56d0-5dce-80e9-75788215df3a

		annotation SummarizationSetBy = User

	/// Role-playing date key: the date the deal was finalized. The governed date basis for every sales
	/// and gross KPI. Active relationship to vw_calendar.
	column sale_date_key
		dataType: int64
		isHidden
		sourceColumn: sale_date_key
		summarizeBy: none
		lineageTag: d588e953-3c81-5d0a-a805-c4c4a746765a

		annotation SummarizationSetBy = User

	/// Role-playing date key: the date the vehicle was delivered. Inactive relationship to vw_calendar;
	/// any delivery-basis measure must be labelled as such.
	column delivery_date_key
		dataType: int64
		isHidden
		sourceColumn: delivery_date_key
		summarizeBy: none
		lineageTag: 3757e54e-33bb-5f8c-9a65-92096c850c66

		annotation SummarizationSetBy = User

	/// Store surrogate key. Relationship column; hide in the semantic model.
	column dealership_key
		dataType: int64
		isHidden
		sourceColumn: dealership_key
		summarizeBy: none
		lineageTag: c9a85f0b-8508-544b-9ecc-8b5da3b2122e

		annotation SummarizationSetBy = User

	/// Vehicle surrogate key. Relationship column; hide in the semantic model.
	column vehicle_key
		dataType: int64
		isHidden
		sourceColumn: vehicle_key
		summarizeBy: none
		lineageTag: 634d2408-3d0e-58e6-a0d7-cd9c697b0387

		annotation SummarizationSetBy = User

	/// Model-line surrogate key, resolved through the vehicle. Relationship column; hide in the
	/// semantic model.
	column vehicle_model_key
		dataType: int64
		isHidden
		sourceColumn: vehicle_model_key
		summarizeBy: none
		lineageTag: 2d5468a4-e566-53f1-904c-7cf8ce640df6

		annotation SummarizationSetBy = User

	/// Customer surrogate key. NULL on wholesale and dealer-trade rows, which have no retail customer.
	column customer_key
		dataType: int64
		isHidden
		sourceColumn: customer_key
		summarizeBy: none
		lineageTag: 3c67c206-3f39-5cae-875b-074229505597

		annotation SummarizationSetBy = User

	/// Role-playing employee key: the selling salesperson.
	column salesperson_key
		dataType: int64
		isHidden
		sourceColumn: salesperson_key
		summarizeBy: none
		lineageTag: 415d7c34-6557-55bf-8aa2-58216a3c4df0

		annotation SummarizationSetBy = User

	/// Role-playing employee key: the desk manager on the deal.
	column desk_manager_key
		dataType: int64
		isHidden
		sourceColumn: desk_manager_key
		summarizeBy: none
		lineageTag: 14b4c573-823f-5f1b-bc98-af33e7e9ac91

		annotation SummarizationSetBy = User

	/// Role-playing employee key: the finance manager on the deal.
	column finance_manager_key
		dataType: int64
		isHidden
		sourceColumn: finance_manager_key
		summarizeBy: none
		lineageTag: 29859c1b-ab96-5d61-8c1d-f9a156e37d04

		annotation SummarizationSetBy = User

	/// Lead source credited with the deal, single-source first-touch. NULL where no source was
	/// recorded.
	column lead_source_key
		dataType: int64
		isHidden
		sourceColumn: lead_source_key
		summarizeBy: none
		lineageTag: 0b9b3a64-3228-5884-8a51-2da4890b22ef

		annotation SummarizationSetBy = User

	/// New Retail, Used Retail, Certified Retail, Lease, Wholesale or Dealer Trade.
	column sale_type
		dataType: string
		sourceColumn: sale_type
		summarizeBy: none
		lineageTag: 51eda24d-6f98-5d63-82c0-fb6bd52140c6

		annotation SummarizationSetBy = User

	/// True for a retail or lease delivery. False for wholesale and dealer trades, which are not retail
	/// units.
	column is_retail
		dataType: boolean
		sourceColumn: is_retail
		summarizeBy: none
		lineageTag: 5214e379-68b9-500e-8894-a894b2795e6b

		annotation SummarizationSetBy = User

	/// Governed new/used split taken from the vehicle. A certified pre-owned unit is Used.
	column condition_group
		dataType: string
		sourceColumn: condition_group
		summarizeBy: none
		lineageTag: f72f0dbd-184c-5810-80f9-dbdaf73a49f1

		annotation SummarizationSetBy = User

	/// New, Used or Certified as recorded on the vehicle.
	column vehicle_condition_type
		dataType: string
		sourceColumn: vehicle_condition_type
		summarizeBy: none
		lineageTag: 7c139fba-f71a-54f6-ae92-fc49895e3ef9

		annotation SummarizationSetBy = User

	/// Always 1. Additive unit measure over every transaction, retail or not.
	column unit_count
		dataType: int64
		sourceColumn: unit_count
		summarizeBy: none
		lineageTag: ce0c5a24-f888-56ee-b355-be333b3f9ed2

		annotation SummarizationSetBy = User

	/// KPI-SLS-001 numerator, and the shared denominator of KPI-GRS-004/005/006 and the KPI-INV-007
	/// mean. 1 on a retail row, 0 otherwise.
	column retail_unit_count
		dataType: int64
		isHidden
		sourceColumn: retail_unit_count
		summarizeBy: none
		lineageTag: d698f9c2-27e0-5de0-a2ea-db312c4b60e8

		annotation SummarizationSetBy = User

	/// KPI-SLS-002 numerator. 1 on a retail delivery of a new vehicle, 0 otherwise. Includes leases of
	/// new vehicles.
	column new_unit_count
		dataType: int64
		isHidden
		sourceColumn: new_unit_count
		summarizeBy: none
		lineageTag: c1811a16-672e-5623-80d8-d60bafd866a3

		annotation SummarizationSetBy = User

	/// KPI-SLS-003 numerator. 1 on a retail delivery of a used or certified vehicle, 0 otherwise.
	/// Includes leases of used vehicles.
	column used_unit_count
		dataType: int64
		isHidden
		sourceColumn: used_unit_count
		summarizeBy: none
		lineageTag: 71ed1471-f72a-5019-8137-847ae9a67326

		annotation SummarizationSetBy = User

	/// Wholesale disposals. Never part of a retail measure; published so wholesale volume can be read
	/// beside the aged-inventory percentage it moves.
	column wholesale_unit_count
		dataType: int64
		isHidden
		sourceColumn: wholesale_unit_count
		summarizeBy: none
		lineageTag: 4efef287-0aa4-50fe-998d-b204e1ce3e0b

		annotation SummarizationSetBy = User

	/// Dealer trades. Never part of a retail measure.
	column dealer_trade_unit_count
		dataType: int64
		isHidden
		sourceColumn: dealer_trade_unit_count
		summarizeBy: none
		lineageTag: fcda5436-c515-5d33-bca6-0bb50c87706a

		annotation SummarizationSetBy = User

	/// Final selling price of the vehicle.
	column sale_price
		dataType: decimal
		sourceColumn: sale_price
		summarizeBy: none
		lineageTag: c893ec07-f924-5871-a83f-c7dbec6b3469

		annotation SummarizationSetBy = User

	/// Manufacturer suggested retail price where one applies, otherwise NULL.
	column msrp
		dataType: decimal
		sourceColumn: msrp
		summarizeBy: none
		lineageTag: a038d354-003f-53c0-8f07-a13316b3e26a

		annotation SummarizationSetBy = User

	/// First advertised price.
	column original_asking_price
		dataType: decimal
		sourceColumn: original_asking_price
		summarizeBy: none
		lineageTag: 5b25cffc-60ba-50cf-bede-68c931301c63

