{
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "portfolio/Dockerfile.railway",
    "watchPatterns": [
      "portfolio/**",
      "powerbi/validation/**",
      "powerbi/ARPI_Performance_Intelligence/**",
      "docs/requirements/**",
      "docs/findings/**",
      "docs/architecture-decisions/**",
      "KPI_CATALOG.md",
      "DATA_DICTIONARY.md",
      "PRIVACY_AND_ETHICS.md",
      "LIMITATIONS.md",
      "ARCHITECTURE.md",
      "README.md",
      "sql/**",
      "data/reference/inventory/**",
      "data/sample/dim_dealership.csv",
      "src/arpi/inventory/spec.py",
      "scripts/check_secrets.py",
      "railway.json",
      ".dockerignore",
      ".railway/railway.ts",
      "deployment/railway/**"
    ]
  },
  "deploy": {
    "healthcheckPath": "/status",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3,
    "numReplicas": 1,
    "sleepApplication": false
  }
}
