###############################################################################
#                                                                             #
#   ARPI -- ENVIRONMENT VARIABLE TEMPLATE                                     #
#                                                                             #
#   THIS FILE IS A TEMPLATE. IT CONTAINS NO REAL SECRETS AND NEVER SHOULD.    #
#                                                                             #
#   Every value below is a placeholder. Copy this file to `.env`, edit your    #
#   copy, and keep it out of version control -- `.env` is gitignored.          #
#                                                                             #
#   ARPI does NOT auto-load `.env`: configuration resolution must be          #
#   reproducible and must not depend on whatever file happens to be in the    #
#   working directory. Export the variables yourself, e.g.                     #
#                                                                             #
#       set -a; source .env; set +a                                            #
#                                                                             #
#   Precedence is: environment variable > config/<profile>.yaml > default.    #
#   Nesting uses a double underscore, e.g. ARPI_DATABASE__HOST.               #
#                                                                             #
###############################################################################

# ---------------------------------------------------------------------------
# Profile selection
# ---------------------------------------------------------------------------

# Which config/<profile>.yaml to load. One of: development | test | portfolio.
# Overridden by the --profile command-line flag. Defaults to development.
ARPI_PROFILE=development

# Master seed for every deterministic generator. Must be a non-negative integer.
# Changing it changes generated data; the calendar dimension is unaffected because
# it is not stochastic.
ARPI_RANDOM_SEED=20250701

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------

# DEBUG | INFO | WARNING | ERROR | CRITICAL
ARPI_LOGGING__LEVEL=INFO

# text (human readable) | json (one JSON object per line, for log shipping)
ARPI_LOGGING__FORMAT=text

# ---------------------------------------------------------------------------
# Reporting window
# ---------------------------------------------------------------------------

# Inclusive ISO-8601 bounds of the generated calendar. end_date must be on or after
# start_date, and the window may not exceed 40 years.
ARPI_REPORTING__START_DATE=2025-07-01
ARPI_REPORTING__END_DATE=2025-12-31

# ---------------------------------------------------------------------------
# Output paths (relative to the directory ARPI is run from; must stay inside it)
# ---------------------------------------------------------------------------

ARPI_PATHS__RAW_OUTPUT_DIR=data/raw

# ---------------------------------------------------------------------------
# Feature flags -- everything here is Planned, not Implemented, in Phase 0.
# ---------------------------------------------------------------------------

ARPI_FEATURES__ENABLE_PUBLIC_VEHICLE_ENRICHMENT=false

# ---------------------------------------------------------------------------
# PostgreSQL (entirely optional -- the Phase 0 slice runs without a database)
# ---------------------------------------------------------------------------

# When true, host, name and user must all be set or configuration fails with an
# actionable message naming the missing keys.
ARPI_DATABASE__ENABLED=false

ARPI_DATABASE__HOST=localhost
ARPI_DATABASE__PORT=5432
ARPI_DATABASE__NAME=arpi
ARPI_DATABASE__USER=arpi_loader

# disable | allow | prefer | require | verify-ca | verify-full
ARPI_DATABASE__SSLMODE=prefer

# ---------------------------------------------------------------------------
# THE ONLY SECRET ARPI READS
# ---------------------------------------------------------------------------
#
# The database password is NEVER read from config/*.yaml -- loading a YAML file that
# contains a `password` key is a hard error. It is read only from the variable below,
# falling back to the standard PGPASSWORD.
#
# The value below is a placeholder. Replace it in your own `.env`, never here.
# ARPI holds it as a SecretStr and redacts it from every repr, str and log line.
ARPI_DATABASE__PASSWORD=replace-me-with-your-local-password
